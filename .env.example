# ==============================================
# NAIK.IN - Environment Variables Example
# Salin file ini menjadi .env.local atau .env:
# cp .env.example .env.local
# ==============================================

# Database PostgreSQL (Lokal / pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=trialtitut

# Atau gunakan connection string langsung (opsional jika menggunakan Neon / Railway / Cloud Postgres)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trialtitut
# DB_SSL=false

# Google Gemini API (Opsional: kosongkan jika hanya menggunakan Mode Demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

